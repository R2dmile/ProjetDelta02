<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Inclure tous les .cs du projet racine (frere de ce csproj), sauf Program.cs et BlazorHybrid -->
    <Compile Include="..\**\*.cs"
             Exclude="..\Program.cs;
                      ..\ProjetDelta.BlazorHybrid\**\*.*;
                      ..\ProjetDelta.Core\**\*.*;
                      ..\obj\**\*.*;
                      ..\bin\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>
</Project>
